# ── Required ──────────────────────────────────────────────────
# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/food-reels

# JWT signing secret (use a 64+ char random string)
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# JWT refresh secret (use a different 64+ char random string)
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_string_at_least_64_chars

# ImageKit credentials (from https://imagekit.io/dashboard)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Optional ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Server port (Render sets this automatically)
PORT=3000

# NODE_ENV: development | production | test
NODE_ENV=development

# Log level: error | warn | info | debug
LOG_LEVEL=debug